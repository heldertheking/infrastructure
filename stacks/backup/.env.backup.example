STACK_NAME=backup

PATH_APPDATA=/opt/appdata/backup
PATH_APPDATA_SOURCE=/opt/appdata
PATH_MEDIA_SOURCE=/mnt/storage-hdd
PATH_LOGS=/var/log/backup

TZ=Europe/Zurich

# Nightly run at 02:30 local time
BACKUP_CRON=0 30 2 * * *

# S3-compatible endpoint + bucket/path.
# Examples:
# - Backblaze B2 (S3): s3:https://s3.eu-central-003.backblazeb2.com/my-bucket/homelab
# - MinIO:            s3:http://minio.example.local:9000/homelab
RESTIC_REPOSITORY=s3:https://s3.example.com/my-bucket/homelab
RESTIC_PASSWORD=replace-with-a-long-random-password
AWS_ACCESS_KEY_ID=replace-with-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret
AWS_DEFAULT_REGION=us-east-1

# Backup behavior (defaults are safe to keep)
RESTIC_BACKUP_ARGS=--exclude=/backup/appdata/**/cache --exclude=/backup/appdata/**/tmp
RESTIC_FORGET_ARGS=--keep-daily 14 --keep-weekly 8 --keep-monthly 6
RESTIC_PRUNE_ARGS=--prune
RESTIC_CHECK_ARGS=--read-data-subset=1/20
