STACK_NAME=monitoring

PATH_APPDATA=/opt/appdata/monitoring
PATH_STORAGE=/mnt/storage-hdd
PATH_LOGS=/opt/appdata/monitoring/logs

TZ=Europe/Zurich
DOMAIN=example.com

# Shoutrrr-compatible notification URL for Watchtower alerts
# See: https://containrrr.dev/shoutrrr/v0.8/services/overview/
# Example (Discord): discord://token@webhookid
NOTIFY_URL=your-shoutrrr-url-here

# Healthchecks.io check UUID used as a dead-man's switch for Uptime Kuma
# Create a check at https://healthchecks.io and paste its UUID here
HC_PING_UUID=your-healthchecks-uuid-here
